# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE (EXEMPLO) — SKDNOTE
# Copie este arquivo para .env e preencha com seus dados reais: cp .env.example .env
# ==============================================================================

# Segurança e Ambiente Django
DEBUG=True
SECRET_KEY=sua-chave-secreta-forte-aqui
ALLOWED_HOSTS=127.0.0.1,localhost,seudominio.com

# E-mail
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=skdnote <noreply@skdnote.com>

# Integração Stripe & Pagamentos Multi-Moeda (BRL, USD, EUR)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs de Preços no Stripe (Mensal, Anual e Vitalício)
STRIPE_PRICE_MONTHLY_BRL=price_...
STRIPE_PRICE_YEARLY_BRL=price_...
STRIPE_PRICE_LIFETIME_BRL=price_...
STRIPE_PRICE_MONTHLY_USD=price_...
STRIPE_PRICE_YEARLY_USD=price_...
STRIPE_PRICE_LIFETIME_USD=price_...
STRIPE_PRICE_MONTHLY_EUR=price_...
STRIPE_PRICE_YEARLY_EUR=price_...
STRIPE_PRICE_LIFETIME_EUR=price_...
